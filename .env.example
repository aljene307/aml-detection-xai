# Copier ce fichier en .env et remplacer les valeurs fictives.
# Le vrai .env n'est jamais commité.
# Attention aux espaces et retours à la ligne en collant une valeur.

# Le jeu SAML-D est public : aucun jeton Kaggle n'est nécessaire.
# À renseigner seulement si on utilise un jour la CLI kaggle.
KAGGLE_USERNAME=exemple_utilisateur
KAGGLE_KEY=valeur_fictive_a_remplacer

# URL de l'API utilisée par l'application Streamlit
API_URL=http://localhost:8000
