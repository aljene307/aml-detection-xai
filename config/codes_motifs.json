    },
    "HORAIRE": {
      "libelle": "Moment de la transaction",
      "variables": ["heure_sin", "heure_cos", "jour_semaine"]
    },
    "DEVISE": {
      "libelle": "Devises",
      "variables": ["devises_differentes", "freq_Payment_currency", "freq_Received_currency"]
    },
    "PAYS": {
      "libelle": "Pays des banques",
      "variables": ["freq_Sender_bank_location", "freq_Receiver_bank_location"]
