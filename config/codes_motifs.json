    "REPRISE_OU_NOUVEAU_EMETTEUR": {
      "libelle": "Émetteur nouveau ou inactif",
      "variables": ["em_ecart_precedent_s", "em_sans_historique_30j"]
    },
    "REPRISE_OU_NOUVEAU_DESTINATAIRE": {
      "libelle": "Destinataire nouveau ou inactif",
