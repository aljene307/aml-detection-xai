      "variables": ["em_ratio_montant_30j"]
    },
    "MONTANT_INHABITUEL_DESTINATAIRE": {
      "libelle": "Montant inhabituel pour le destinataire",
      "variables": ["re_ratio_montant_30j"]
    },
    "RAFALE_EMETTEUR": {
      "libelle": "Rafale d'envois",
      "variables": ["em_nb_1h", "em_nb_24h"]
    },
    "RAFALE_DESTINATAIRE": {
      "libelle": "Rafale de réceptions",
      "variables": ["re_nb_1h", "re_nb_24h"]
    },
    "CONTREPARTIES_MULTIPLES_EMETTEUR": {
      "libelle": "Nombreux destinataires différents",
      "variables": ["em_nb_distincts_24h", "em_nb_distincts_30j"]
